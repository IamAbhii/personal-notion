{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Edit",
      "Write",
      "Task",
      "WebFetch",
      "WebSearch",
      "Skill",
      "LSP",
      "mcp__context7__resolve-library-id",
      "mcp__context7__query-docs",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(node:*)",
      "Bash(pnpm:*)",
      "Bash(git:*)",
      "Bash(mkdir:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(curl:*)"
    ],
    "deny": [
      "Edit(REQUIREMENTS.md)",
      "Write(REQUIREMENTS.md)",
      "Read(./.env)"
    ]
  }
}
